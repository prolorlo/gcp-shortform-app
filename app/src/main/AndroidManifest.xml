<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 하루 1번 서버(Firebase) 동기화 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 동기화 선택 항목: 유튜브·인스타그램 앱 버전 확인. 홈 앱 확인은 빼꼼 모찌 홈 산책용 -->
    <queries>
        <package android:name="com.google.android.youtube" />
        <package android:name="com.instagram.android" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:name=".ShortFormPetApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ShortFormPet">

        <!-- 실행 아이콘은 아래 activity-alias 5개 중 하나만 켜집니다 (행복도 표정, AppIconSwitcher) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop" />

        <activity-alias
            android:name=".AliasMoodJoyful"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_mood_1"
            android:roundIcon="@mipmap/ic_launcher_mood_1"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".AliasMoodSmile"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_mood_2"
            android:roundIcon="@mipmap/ic_launcher_mood_2"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".AliasMoodHungry"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_mood_3"
            android:roundIcon="@mipmap/ic_launcher_mood_3"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".AliasMoodSulky"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_mood_4"
            android:roundIcon="@mipmap/ic_launcher_mood_4"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".AliasMoodSick"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_mood_5"
            android:roundIcon="@mipmap/ic_launcher_mood_5"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 쇼츠·릴스 화면 감지 및 시청 시간 측정 -->
        <service
            android:name=".ShortFormAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 홈 화면 2×2 위젯 -->
        <receiver
            android:name=".MochiWidgetProvider"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mochi_widget_info" />
        </receiver>

        <!-- 네트워크가 연결됐을 때 밀린 기록 전송 -->
        <service
            android:name=".SyncJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- 새벽 5시 하루 정산 -->
        <receiver
            android:name=".DailyResetReceiver"
            android:exported="false" />

        <!-- 오전 9시 집중 쪽지 -->
        <receiver
            android:name=".MorningNoteReceiver"
            android:exported="false" />

        <!-- 재부팅 후 알람 재등록 -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
